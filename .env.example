# Copy to .env.local and fill in your values (local dev). Set the same
# variables in Vercel for production.

# Where money lands — REQUIRED for real checkout
SHOP_BTC_ADDR=bc1qyourbtcaddress
SHOP_LTC_ADDR=LLDrebngQKMVvwsV5Lk1Z99SDFcXF8XdbF
SHOP_USDT_TRC20_ADDR=Tyourtronaddress

# Admin API password (protect the key stock + orders endpoints)
ADMIN_PASSWORD=change-me-to-something-long

# Optional: if set, orders persist to Upstash Redis instead of local JSON.
# On Vercel, attach the Upstash Redis storage integration and these are
# injected automatically as KV_REST_API_URL / KV_REST_API_TOKEN.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
